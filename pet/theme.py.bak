_THEMES: dict[str, dict] = {"space": _SPACE}
_current = "space"


def current_theme() -> str:
    """当前主题名（恒为 "space"）。"""
    return _current


def set_theme(name: str | None = None) -> None:
    """兼容旧接口：恒设为 space 主题。旧调用传 light/dark 也归一到 space。"""
    global _current
    _current = "space"
    globals().update(_SPACE)


def detect_system_theme() -> str:
    """兼容旧接口：恒返回 "space"（固定暗色太空主题）。"""
    return "space"


# ---------------------------------------------------------------------------
# 间距 / 尺寸
# ---------------------------------------------------------------------------
PAD_PAGE = 24            # 页面边距（大留白）
PAD_CARD = 16            # 卡片内边距
GAP_CARD = 16            # 卡片间距（8pt 网格）
RADIUS = 16              # Canvas 视觉元素圆角
RADIUS_CARD = 20         # 大卡片圆角（Bento 模块卡）
NAV_WIDTH = 160          # 侧边栏宽
NAV_ITEM_H = 38          # 导航项高
STAT_H = 108             # 统计卡高

# 动效 token：hover/交互平滑过渡
MOTION_MS = 180          # 过渡时长
MOTION_STEPS = 8         # 颜色渐变插值步数

APP_NAME = "回顾 Agent"
APP_VERSION = "v1.1.0-orbis"


def apply_window_material(win, *, acrylic: bool = True) -> None:
    """给顶层窗口应用深空 Acrylic 磨砂材质 + 标题栏跟随暗色。

    pywinstyles 缺失或调用失败时静默降级为纯色主题，绝不抛异常。
    """
    try:
        import pywinstyles
    except Exception:  # noqa: BLE001
        return
    try:
        if acrylic:
            pywinstyles.apply_style(win, "acrylic")
        pywinstyles.change_title_color(win, "#EFF4FF")
        pywinstyles.change_border_color(win, _SPACE["BORDER"])
    except Exception:  # noqa: BLE001
        pass


# 默认激活 space 主题（main.py 启动后调用 ensure_fonts 刷新字体）
set_theme("space")
