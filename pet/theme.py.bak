    "GLASS_HI": "#3A4A8A",      # 玻璃顶部高光（≈ rgba 白 15%）
    "GLASS_EDGE": "#1C2450",    # 玻璃渐变边缘描边
    "FOCUS_RING": "#6FFF00",    # 键盘焦点描边（2px 霓虹绿）
