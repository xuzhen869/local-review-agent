"""全局设计 token：Orbis 太空风（深空蓝 + 霓虹绿 + liquid-glass 玻璃）。

视觉语言：固定暗色太空主题（#010828 深空海军蓝底 / #EFF4FF 奶油白字 / #6FFF00 霓虹绿点缀），
Anton 压缩标题字体 + Condiment 手写体点缀 + 等宽正文标签 + 玻璃卡片渐变边缘。

设计来源：Orbis.Nft 网页模板（Anton/Condiment/liquid-glass/neon）转换为桌面 tkinter 实现。
Anton/Condiment 通过 AddFontResourceExW 私有注册（不写入系统），缺失自动回退系统字体。

注意：本文件为单一「space」主题；set_theme / detect_system_theme 保留接口以兼容旧调用，
内部恒为 space。UI 组件在创建时读取当前 token。
"""
from __future__ import annotations

import os
import sys
import tkinter.font as _tkfont

# ---------------------------------------------------------------------------
# 字体（Anton=压缩标题 / Condiment=手写点缀 / 等宽=正文标签 / YaHei=中文正文）
# Anton 无 CJK 字形：中文标题走 F_SANS(YaHei Bold)，拉丁与数字走 F_GROTESK
# ---------------------------------------------------------------------------
def _fams() -> set[str]:
    try:
        return set(_tkfont.families())
    except Exception:  # noqa: BLE001  无 Tk root 时无法枚举
        return set()


def _pick(family: str, *fallbacks: str) -> str:
    fams = _fams()
    for f in (family, *fallbacks):
        if f in fams:
            return f
    return family


# 拉丁/数字显示字体（Anton 私有注册后启用；回退链压缩黑体）
F_GROTESK = _pick("Anton", "Arial Black", "Segoe UI Variable Display", "Segoe UI")
# 手写体点缀（Condiment；回退 Windows 自带西文手写体）
F_CONDIMENT = _pick("Condiment", "Segoe Script", "Segoe Print", "Segoe UI")
# 中文正文（Anton 无 CJK，中文标题/正文用现代黑体）
F_SANS = _pick("Segoe UI Variable Text", "Segoe UI", "Microsoft YaHei UI")
# 显示大数字（统计数字 → Anton）
F_DISPLAY = F_GROTESK

F_TITLE = (F_SANS, 18, "bold")       # 页面大标题（中文）
F_H = (F_SANS, 13, "bold")           # 卡片 / 区块标题
F_BODY = (F_SANS, 10)                # 正文 / 按钮
F_SMALL = (F_SANS, 9)                # 次要文字 / 副标题
F_TINY = (F_SANS, 8)                 # 图例 / 角标
F_MONO = ("Cascadia Mono", "Consolas", "monospace")  # 代码 / 时间戳 / 标签
F_STAT = (F_GROTESK, 22, "normal")   # 统计大数字（Anton 压缩感）
F_STAT_SMALL = (F_GROTESK, 14, "normal")  # 统计大数字（超宽降级）
F_HERO = (F_GROTESK, 32, "normal")   # Hero 大标题（拉丁/数字）
F_CUR = (F_CONDIMENT, 24, "normal")  # 手写体点缀基准字号
F_EMOJI = ("Segoe UI Emoji", 12)     # 图标 emoji
F_NAV = (F_SANS, 10, "bold")         # 侧边栏导航文字
F_ICON = _pick("Segoe Fluent Icons", "Segoe UI Symbol", "Segoe MDL2 Assets")  # 线框图标字体

# ---------------------------------------------------------------------------
# 字体私有注册（AddFontResourceExW，不写入系统）
# ---------------------------------------------------------------------------
_FONT_DIRS = None


def _find_font_dir() -> str | None:
    """定位 assets/fonts：优先 _MEIPASS（PyInstaller），再 exe 旁，最后源码项目根。"""
    global _FONT_DIRS
    if _FONT_DIRS is not None:
        return _FONT_DIRS
    cands: list[str] = []
    if getattr(sys, "_MEIPASS", None):
        cands.append(os.path.join(sys._MEIPASS, "assets", "fonts"))
    if getattr(sys, "frozen", False) and sys.executable:
        cands.append(os.path.join(os.path.dirname(sys.executable), "assets", "fonts"))
    cands.append(os.path.join(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__))),  # pet/.. = 项目根
        "assets", "fonts"))
    for c in cands:
        if os.path.isdir(c):
            _FONT_DIRS = c
            return c
    return None


def _register_font(path: str) -> None:
    try:
        import ctypes
        FR_PRIVATE = 0x10
        if os.path.exists(path):
            ctypes.windll.gdi32.AddFontResourceExW(os.fspath(path), FR_PRIVATE, 0)
    except Exception:  # noqa: BLE001
        pass


def ensure_fonts() -> None:
    """注册 Anton/Condiment 私有字体并刷新相关字体 token。

    必须在 Tk root 创建后调用（tkinter 需要 root 才能枚举字体）。
    失败时静默回退系统字体，绝不抛异常。
    """
    global F_GROTESK, F_CONDIMENT, F_DISPLAY
    global F_STAT, F_STAT_SMALL, F_HERO, F_CUR
    d = _find_font_dir()
    if d:
        for f in ("Anton-Regular.ttf", "Condiment-Regular.ttf"):
            _register_font(os.path.join(d, f))
    F_GROTESK = _pick("Anton", "Arial Black", "Segoe UI Variable Display", "Segoe UI")
    F_CONDIMENT = _pick("Condiment", "Segoe Script", "Segoe Print", "Segoe UI")
    F_DISPLAY = F_GROTESK
    F_STAT = (F_GROTESK, 22, "normal")
    F_STAT_SMALL = (F_GROTESK, 14, "normal")
    F_HERO = (F_GROTESK, 32, "normal")
    F_CUR = (F_CONDIMENT, 24, "normal")


